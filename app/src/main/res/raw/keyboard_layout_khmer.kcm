# Modified: fixed invalid code points (U+17FB-17FF), Shift+G = U+17A2,
# added missing Khmer characters on Right-Alt.
#
# NOTE ON THE NiDA TWO-CODE-POINT KEYS (Shift+A and Shift+COMMA)
#
# The NiDA layout puts two *sequences* on the shift layer:
#     Shift+A     -> U+17B6 U+17C6   (SARA AA + NIKAHIT)
#     Shift+COMMA -> U+17BB U+17C6   (SARA U  + NIKAHIT)
#
# An Android .kcm behavior can only ever be ONE UTF-16 code unit: the
# platform parser (KeyCharacterMap.cpp, parseCharacterLiteral) reads a
# single character between the quotes, and parseKeyProperty rejects a
# second literal with "Cannot combine multiple character literals".
# Writing '\u17b6\u17c6' makes the WHOLE file fail to load, which silently
# drops the layout back to Generic.kcm.
#
# So the shift layer below carries the FIRST code point of each sequence
# (the NiDA leading character); press Shift+M (U+17C6 NIKAHIT) to complete
# the cluster. Enable the bundled "Khmer Unicode sequence keys" input
# method to get both sequences from the single keystroke instead.
#
# The ASCII characters that previously sat in those two slots are kept:
#   '+' moved to Shift+RightAlt+A, ';' moved to RightAlt+COMMA
#       (RightAlt+COMMA previously repeated ',' , which base already types).

type OVERLAY

#
# Number Row Character Key
#

key 1 {
    label:                              '1'
    base:                               '\u17e1'
    shift:                              '!'
    ralt:                               '\u200c'
}
key 2 {
    label:                              '2'
    base:                               '\u17e2'
    shift:                              '\u17d7'
    ralt:                               '@'
}
key 3 {
    label:                              '3'
    base:                               '\u17e3'
    shift:                              '#'
    ralt:                               '\u17d1'
}
key 4 {
    label:                              '4'
    base:                               '\u17e4'
    shift:                              '\u17db'
    ralt:                               '$'
}
key 5 {
    label:                              '5'
    base:                               '\u17e5'
    shift:                              '%'
    ralt:                               '\u20ac'
}
key 6 {
    label:                              '6'
    base:                               '\u17e6'
    shift:                              '\u17cd'
    ralt:                               '\u17d9'
}
key 7 {
    label:                              '7'
    base:                               '\u17e7'
    shift:                              '\u17d0'
    ralt:                               '\u17da'
}
key 8 {
    label:                              '8'
    base:                               '\u17e8'
    shift:                              '\u17cf'
    ralt:                               '*'
}
key 9 {
    label:                              '9'
    base:                               '\u17e9'
    shift:                              '('
    ralt:                               '{'
}
key 0 {
    label:                              '0'
    base:                               '\u17e0'
    shift:                              ')'
    ralt:                               '}'
}

#
# Default QWERTY A-Z Character Key
#

key A {
    label:                              'A'
    base:                               '\u17b6'
    # NiDA Shift+A is the sequence U+17B6 U+17C6 (SARA AM); a .kcm can only
    # emit the first code point. Shift+M adds U+17C6 to complete it.
    shift:                              '\u17b6'
    ralt:                               '^'
    shift+ralt:                         '+'
}
key B {
    label:                              'B'
    base:                               '\u1794'
    shift:                              '\u1796'
    ralt:                               '\u179e'
}
key C {
    label:                              'C'
    base:                               '\u1785'
    shift:                              '\u1787'
}
key D {
    label:                              'D'
    base:                               '\u178a'
    shift:                              '\u178c'
}
key E {
    label:                              'E'
    base:                               '\u17c1'
    shift:                              '\u17c2'
    ralt:                               '\u17af'
}
key F {
    label:                              'F'
    base:                               '\u1790'
    shift:                              '\u1792'
}
key G {
    label:                              'G'
    base:                               '\u1784'
    shift:                              '\u17a2'
    ralt:                               '\u17a3'
}
key H {
    label:                              'H'
    base:                               '\u17a0'
    shift:                              '\u17c7'
}
key I {
    label:                              'I'
    base:                               '\u17b7'
    shift:                              '\u17b8'
    ralt:                               '\u17a6'
}
key J {
    label:                              'J'
    base:                               '\u17d2'
    shift:                              '\u1789'
}
key K {
    label:                              'K'
    base:                               '\u1780'
    shift:                              '\u1782'
    ralt:                               '\u179d'
}
key L {
    label:                              'L'
    base:                               '\u179b'
    shift:                              '\u17a1'
    ralt:                               '\u17d8'
}
key M {
    label:                              'M'
    base:                               '\u1798'
    shift:                              '\u17c6'
}
key N {
    label:                              'N'
    base:                               '\u1793'
    shift:                              '\u178e'
}
key O {
    label:                              'O'
    base:                               '\u17c4'
    shift:                              '\u17c5'
    ralt:                               '\u17b1'
}
key P {
    label:                              'P'
    base:                               '\u1795'
    shift:                              '\u1797'
    ralt:                               '\u17b0'
}
key Q {
    label:                              'Q'
    base:                               '\u1786'
    shift:                              '\u1788'
    ralt:                               '\u17dc'
}
key R {
    label:                              'R'
    base:                               '\u179a'
    shift:                              '\u17ac'
    ralt:                               '\u17ab'
}
key S {
    label:                              'S'
    base:                               '\u179f'
    shift:                              '\u17c3'
}
key T {
    label:                              'T'
    base:                               '\u178f'
    shift:                              '\u1791'
    ralt:                               '\u17a8'
}
key U {
    label:                              'U'
    base:                               '\u17bb'
    shift:                              '\u17bc'
    ralt:                               ']'
}
key V {
    label:                              'V'
    base:                               '\u179c'
    shift:                              '&'
}
key W {
    label:                              'W'
    base:                               '\u17b9'
    shift:                              '\u17ba'
    ralt:                               '\u17dd'
}
key X {
    label:                              'X'
    base:                               '\u1781'
    shift:                              '\u1783'
    ralt:                               '>'
}
key Y {
    label:                              'Y'
    base:                               '\u1799'
    shift:                              '\u17bd'
    ralt:                               '['
}
key Z {
    label:                              'Z'
    base:                               '\u178b'
    shift:                              '\u178d'
    ralt:                               '<'
}

#
# Special Character Key
#

# Within Number Row Key
key GRAVE {
    label:                              '`'
    base:                               '\u00AB'
    shift:                              '\u00BB'
    ralt:                               '\u200d'
}
key MINUS {
    label:                              '-'
    base:                               '\u17a5'
    shift:                              '\u17cc'
}
key EQUALS {
    label:                              '='
    base:                               '\u17b2'
    shift:                              '='
    ralt:                               '\u17ce'
}
key BACKSLASH {
    label:                              '\\'
    base:                               '\u17ae'
    shift:                              '\u17ad'
    ralt:                               '\\'
}

# Within QWERTY Key
key LEFT_BRACKET {
    label:                              '['
    base:                               '\u17c0'
    shift:                              '\u17bf'
    ralt:                               '\u17a9'
}

key RIGHT_BRACKET {
    label:                              ']'
    base:                               '\u17aa'
    shift:                              '\u17a7'
    ralt:                               '\u17b3'
}
key SEMICOLON {
    label:                              ';'
    base:                               '\u17be'
    shift:                              ':'
    ralt:                               '\u17d6'
}
key APOSTROPHE {
    label:                              '\''
    base:                               '\u17cb'
    shift:                              '\u17c9'
    ralt:                               '\u17c8'
}
key COMMA {
    label:                              ','
    base:                               ','
    # NiDA Shift+COMMA is the sequence U+17BB U+17C6 (SARA OM); a .kcm can
    # only emit the first code point. Shift+M adds U+17C6 to complete it.
    shift:                              '\u17bb'
    ralt:                               ';'
}
key PERIOD {
    label:                              '.'
    base:                               '\u17d4'
    shift:                              '\u17d5'
    ralt:                               '.'
}
key SLASH {
    label:                              '/'
    base:                               '\u17ca'
    shift:                              '?'
    ralt:                               '/'
    alt, meta:                          fallback SEARCH
    ctrl:                               fallback LANGUAGE_SWITCH
}
key SPACE {
    label:                              ' '
    base:                               '\u200b'
    shift:                              ' '
    alt, meta:                          fallback SEARCH
    ctrl:                               fallback LANGUAGE_SWITCH
}

### Non-printing keys
key ESCAPE {
    base:                               fallback BACK
    alt, meta:                          fallback HOME
    ctrl:                               fallback MENU
}
