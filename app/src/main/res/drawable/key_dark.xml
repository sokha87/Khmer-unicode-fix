<?xml version="1.0" encoding="utf-8"?>
<!-- Key face for the dark keyboard. The inset is what separates one key from
     the next: KeyboardView draws each key at its full cell, with no gap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="1.5dp" android:insetRight="1.5dp"
               android:insetTop="1.5dp" android:insetBottom="1.5dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF5A5A5E" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="1.5dp" android:insetRight="1.5dp"
               android:insetTop="1.5dp" android:insetBottom="1.5dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF3A3A3C" />
                <corners android:radius="6dp" />
            </shape>
        </inset>
    </item>
</selector>
