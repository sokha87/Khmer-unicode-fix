<?xml version="1.0" encoding="utf-8"?>
<!--
    The on-screen keyboard, shown only when no physical keyboard is attached
    (see InputMethodService.onEvaluateInputViewShown). No explicit colours: the
    platform's keyboardViewStyle supplies key backgrounds and text colours that
    follow the device theme.
-->
<android.inputmethodservice.KeyboardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:keyPreviewLayout="@layout/key_preview" />
